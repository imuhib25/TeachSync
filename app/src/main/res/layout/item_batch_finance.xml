<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#1E293B"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvBatchName"
                    android:text="HSC 2026"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvCycleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cycle-1"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginEnd="12dp"
                    android:background="#334155"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvCollectedAmount"
                    android:text="৳ 12,000"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvStudentCount"
                    android:text="15 Students"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvDueAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due: ৳ 3,000"
                    android:textColor="#F59E0B"
                    android:textSize="12sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBatchCollection"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:progress="80"
                android:progressTint="#4CAF50"/>

        </LinearLayout>

        <!-- Completed Overlay -->
        <FrameLayout
            android:id="@+id/layoutCompletedOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@android:id/content"
            android:layout_alignBottom="@android:id/content"
            android:background="#991E293B"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="COMPLETED"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:rotation="-15"
                android:padding="8dp"
                android:background="@drawable/bg_completed_stamp" />
        </FrameLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
